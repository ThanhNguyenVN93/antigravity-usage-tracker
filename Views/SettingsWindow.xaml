<Window x:Class="AntigravityUsageTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Background="#1E1E2E" WindowStartupLocation="Manual">
    <StackPanel Margin="18">
        <TextBlock x:Name="LblLanguage" Foreground="#A6ADC8" FontSize="11"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <RadioButton x:Name="RbVi" Content="Tiếng Việt" Foreground="#CDD6F4" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbEn" Content="English" Foreground="#CDD6F4"/>
        </StackPanel>

        <TextBlock x:Name="LblBudget5h" Foreground="#A6ADC8" FontSize="11"/>
        <TextBox x:Name="TbBudget5h" Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>
        <TextBlock x:Name="LblBudget7d" Foreground="#A6ADC8" FontSize="11"/>
        <TextBox x:Name="TbBudget7d" Style="{StaticResource DarkTextBox}" Margin="0,4,0,2"/>
        <TextBlock x:Name="LblHint" Foreground="#6C7086" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="LblAlert1" Foreground="#A6ADC8" FontSize="11"/>
                <TextBox x:Name="TbAlert1" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="LblAlert2" Foreground="#A6ADC8" FontSize="11"/>
                <TextBox x:Name="TbAlert2" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="LblScan" Foreground="#A6ADC8" FontSize="11"/>
        <TextBox x:Name="TbScan" Style="{StaticResource DarkTextBox}" Margin="0,4,0,10"/>

        <CheckBox x:Name="CbSyncAgyQuota" Foreground="#CDD6F4" Margin="0,0,0,6"/>
        <TextBlock x:Name="LblQuotaSyncMin" Foreground="#A6ADC8" FontSize="11"/>
        <TextBox x:Name="TbQuotaSyncMin" Style="{StaticResource DarkTextBox}" Margin="0,4,0,10"/>

        <TextBlock x:Name="LblContextAlert" Foreground="#A6ADC8" FontSize="11"/>
        <TextBox x:Name="TbContextAlert" Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>
        <TextBlock x:Name="LblWebhook" Foreground="#A6ADC8" FontSize="11"/>
        <TextBox x:Name="TbWebhookUrl" Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>
        <TextBlock x:Name="LblOpacity" Foreground="#A6ADC8" FontSize="11"/>
        <Slider x:Name="SlOpacity" Minimum="0.5" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>

        <CheckBox x:Name="CbStartup" Foreground="#CDD6F4" Margin="0,0,0,6"/>
        <CheckBox x:Name="CbShowHud" Foreground="#CDD6F4" Margin="0,0,0,6"/>
        <CheckBox x:Name="CbAutoHideHud" Foreground="#CDD6F4" Margin="0,0,0,6"/>
        <CheckBox x:Name="CbCompactHud" Foreground="#CDD6F4" Margin="0,0,0,6"/>
        <CheckBox x:Name="CbPrivacyMode" Foreground="#CDD6F4" Margin="0,0,0,6"/>
        <CheckBox x:Name="CbDockClaude" Foreground="#CDD6F4" Margin="0,0,0,6"/>
        <CheckBox x:Name="CbHotkeys" Foreground="#CDD6F4" Margin="0,0,0,10"/>

        <TextBlock x:Name="TxtError" Foreground="#F38BA8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Style="{StaticResource FlatBtn}" Background="#89B4FA" Foreground="#11111B" Margin="0,0,8,0" MinWidth="72" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Style="{StaticResource FlatBtn}" MinWidth="72" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
