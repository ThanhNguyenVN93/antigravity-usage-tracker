<Window x:Class="AntigravityUsageTracker.Views.MiniHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Usage HUD" SizeToContent="Height" Width="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">

    <Border Background="#181825" CornerRadius="12" BorderBrush="#45475A" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <TextBlock x:Name="TxtHudTitle" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="#A6ADC8"
                            FontSize="12" FontWeight="Bold" Width="24" Height="24" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="14,10">
                <TextBlock x:Name="TxtModel" FontSize="13" FontWeight="Bold" Foreground="#F5E0DC"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="TxtNoData" FontSize="11" FontStyle="Italic" Foreground="#A6ADC8" Margin="0,2,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="102"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Circular gauge -->
                    <Grid Grid.Column="0" Width="92" Height="92" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Width="84" Height="84" Stroke="#313244" StrokeThickness="7"/>
                        <Path x:Name="RingArc" Stroke="#89B4FA" StrokeThickness="7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtRingMain" FontSize="15" FontWeight="Bold" Foreground="#CDD6F4"
                                       HorizontalAlignment="Center" Text="-"/>
                            <TextBlock x:Name="TxtRingSub" FontSize="10" Foreground="#A6ADC8"
                                       HorizontalAlignment="Center" Text="5h"/>
                        </StackPanel>
                    </Grid>

                    <!-- Metrics beside the ring -->
                    <Grid x:Name="MetricsGrid" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="Lbl5h" Grid.Row="0" FontSize="11" Foreground="#A6ADC8" Margin="0,2"/>
                        <TextBlock x:Name="Val5h" Grid.Row="0" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#CDD6F4" Margin="0,2"/>
                        <TextBlock x:Name="Lbl24h" Grid.Row="1" FontSize="11" Foreground="#A6ADC8" Margin="0,2"/>
                        <TextBlock x:Name="Val24h" Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#CDD6F4" Margin="0,2"/>
                        <TextBlock x:Name="Lbl7d" Grid.Row="2" FontSize="11" Foreground="#A6ADC8" Margin="0,2"/>
                        <TextBlock x:Name="Val7d" Grid.Row="2" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#CDD6F4" Margin="0,2"/>
                        <TextBlock x:Name="LblBurn" Grid.Row="3" FontSize="11" Foreground="#A6ADC8" Margin="0,2"/>
                        <TextBlock x:Name="ValBurn" Grid.Row="3" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#FAB387" Margin="0,2"/>
                        <TextBlock x:Name="LblContext" Grid.Row="4" FontSize="11" Foreground="#A6ADC8" Margin="0,2"/>
                        <TextBlock x:Name="ValContext" Grid.Row="4" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,2"/>
                        <TextBlock x:Name="LblReset5h" Grid.Row="5" FontSize="11" Foreground="#A6ADC8" Margin="0,2"/>
                        <TextBlock x:Name="ValReset5h" Grid.Row="5" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#F9E2AF" Margin="0,2"/>
                        <TextBlock x:Name="LblReset7d" Grid.Row="6" FontSize="11" Foreground="#A6ADC8" Margin="0,2"/>
                        <TextBlock x:Name="ValReset7d" Grid.Row="6" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#F9E2AF" Margin="0,2"/>
                    </Grid>
                </Grid>

                <StackPanel x:Name="Panel5h" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="LblBudget5h" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtPct5h" FontSize="12" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" Background="#313244" CornerRadius="4">
                        <ProgressBar x:Name="Pb5h" Maximum="100" Height="8" Foreground="#A6E3A1" Background="Transparent" BorderThickness="0"/>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Panel7d" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="LblBudget7d" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtPct7d" FontSize="12" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" Background="#313244" CornerRadius="4">
                        <ProgressBar x:Name="Pb7d" Maximum="100" Height="8" Foreground="#A6E3A1" Background="Transparent" BorderThickness="0"/>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelExtra" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtForecast" FontSize="11" Foreground="#F9E2AF" Margin="0,0,0,3" Visibility="Collapsed"/>
                    <Grid>
                        <TextBlock x:Name="LblCost" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ValCost" FontSize="11" FontWeight="SemiBold" Foreground="#94E2D5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border x:Name="BadgeErrors" Background="#F38BA8" CornerRadius="8" Padding="8,1" Margin="0,5,0,0"
                            HorizontalAlignment="Left" Visibility="Collapsed"
                            Cursor="Hand" MouseLeftButtonUp="BadgeErrors_MouseLeftButtonUp">
                        <TextBlock x:Name="TxtErrors" FontSize="10" FontWeight="Bold" Foreground="#11111B"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="TxtServerQuota" FontSize="10" Foreground="#94E2D5" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtUpdated" FontSize="10" FontStyle="Italic" Foreground="#6C7086" Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                    <Button x:Name="BtnRefresh" Style="{StaticResource FlatBtn}" Padding="8,4" FontSize="10" Margin="0,0,6,0" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnStats" Style="{StaticResource FlatBtn}" Padding="8,4" FontSize="10" Margin="0,0,6,0" Click="BtnStats_Click"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource FlatBtn}" Padding="8,4" FontSize="10" Margin="0,0,6,0" Click="BtnSettings_Click"/>
                    <Button x:Name="BtnCompact" Style="{StaticResource FlatBtn}" Padding="8,4" FontSize="10" Click="BtnCompact_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
