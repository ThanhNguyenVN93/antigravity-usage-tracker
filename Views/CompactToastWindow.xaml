<Window x:Class="AntigravityUsageTracker.Views.CompactToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compact" Width="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual">

    <Border Background="#181825" CornerRadius="10" BorderBrush="#45475A" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="TxtTitle" FontSize="11" FontWeight="Bold" Foreground="#89B4FA"
                           VerticalAlignment="Center" Margin="0,0,28,0"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#A6ADC8"
                        FontSize="12" FontWeight="Bold" Width="24" Height="24" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <TextBlock x:Name="TxtStatus" Grid.Row="1" FontSize="12" FontWeight="SemiBold" Foreground="#CDD6F4"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtNote" Grid.Row="2" FontSize="10" Foreground="#A6ADC8"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </Grid>
    </Border>
</Window>
